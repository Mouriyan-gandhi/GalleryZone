# The whole product in one repo: the Next.js site (frontend-web/), its NestJS
# API (backend/) and the Flutter app (mobile/). Everything else at the root is
# workspace scratch and stays untracked unless listed here.
/*
!/frontend-web/
!/backend/
!/mobile/
!/docs/
!/.github/
!/.gitignore
!/README.md

# The single env file lives at the root — never committed.
/.env
