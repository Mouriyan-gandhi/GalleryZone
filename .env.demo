# Local demo world: Firebase emulators + a fake S3 bucket, seeded by
# `npm run demo:seed` (backend). Safe to commit — every value is a local
# placeholder. The project id starts with "demo-", which the emulators treat as
# offline-only, and mail, payment and monitoring keys are deliberately empty,
# so nothing here can reach production.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-galleryzone
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Empty on purpose: demo mode reports nothing to Sentry.
NEXT_PUBLIC_SENTRY_DSN=

NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=demo-galleryzone
GCP_PROJECT_ID=demo-galleryzone
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PAYMENTS_MODE=simulated
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
SENTRY_DSN=
RESEND_API_KEY=

S3_BUCKET=gz-demo
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_ENDPOINT=http://127.0.0.1:4568
S3_REGION=us-east-1
